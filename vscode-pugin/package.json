{
  "name": "kiro-ai-coverage-collector",
  "displayName": "Kiro AI Coverage Collector",
  "description": "Track and report AI vs human code contributions in Kiro IDE.",
  "version": "0.7.4",
  "publisher": "kiro-ai-coverage-collector",
  "repository": {
    "type": "git",
    "url": "https://github.com/git-ai-project/git-ai"
  },
  "engines": {
    "vscode": ">=1.99.3",
    "node": ">=20.18.1"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "Kiro AI Coverage Collector",
      "properties": {
        "kiroAiCoverage.enableCheckpointLogging": {
          "type": "boolean",
          "default": false,
          "description": "Enable notifications for AI and human edit detection."
        },
        "kiroAiCoverage.statsUploadUrl": {
          "type": "string",
          "default": "",
          "description": "HTTP endpoint URL for uploading commit stats"
        },
        "kiroAiCoverage.statsUploadToken": {
          "type": "string",
          "default": "",
          "description": "Bearer token for authenticating stats upload requests"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npx tsc -p ./",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "yarn run compile && yarn run lint",
    "lint": "eslint src",
    "test": "vscode-test",
    "package": "yarn run copy-static && yarn run compile && vsce package",
    "copy-static": "cp ../../assets/docs/git-ai.png ./git-ai.png",
    "publish": "vsce publish"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "25.x",
    "@types/vscode": "1.99.1",
    "@typescript-eslint/eslint-plugin": "^8.31.1",
    "@typescript-eslint/parser": "^8.31.1",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "3.7.1",
    "eslint": "^9.25.1",
    "ovsx": "0.10.9",
    "typescript": "^5.8.3"
  },
  "resolutions": {
    "glob": ">=11.1.0",
    "tar-fs": ">=2.1.4",
    "test-exclude": ">=7.0.0"
  },
  "dependencies": {
  }
}
