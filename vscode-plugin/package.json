{
  "name": "git-ai-for-kiro",
  "displayName": "git-ai for Kiro",
  "description": "通过 Kiro hooks 追踪 AI 和人工生成的代码行，集成 git-ai checkpoint。",
  "version": "0.3.0",
  "publisher": "git-ai-kiro",
  "repository": {
    "type": "git",
    "url": "https://github.com/git-ai-project/git-ai"
  },
  "engines": {
    "vscode": ">=1.99.3",
    "node": ">=20.18.1"
  },
  "categories": ["Other"],
  "activationEvents": ["onStartupFinished"],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "git-ai for Kiro",
      "properties": {
        "gitAiKiro.enableCheckpointLogging": {
          "type": "boolean",
          "default": false,
          "description": "启用 checkpoint 日志通知"
        },
        "gitAiKiro.agentName": {
          "type": "string",
          "default": "kiro",
          "description": "上报给 git-ai 的 agent 名称"
        },
        "gitAiKiro.model": {
          "type": "string",
          "default": "kiro-ai",
          "description": "上报给 git-ai 的模型名称"
        }
      }
    },
    "commands": [
      {
        "command": "git-ai-kiro.manualCheckpoint",
        "title": "Git AI: 手动触发 Checkpoint",
        "category": "Git AI Kiro"
      },
      {
        "command": "git-ai-kiro.removeHooks",
        "title": "Git AI: 移除工作区 Hooks",
        "category": "Git AI Kiro"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src",
    "package": "yarn run compile && vsce package"
  },
  "devDependencies": {
    "@types/node": "22.x",
    "@types/vscode": "1.99.1",
    "@typescript-eslint/eslint-plugin": "^8.31.1",
    "@typescript-eslint/parser": "^8.31.1",
    "@vscode/vsce": "3.7.1",
    "eslint": "^9.25.1",
    "typescript": "^5.8.3"
  }
}
